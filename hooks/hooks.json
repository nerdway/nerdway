{
  "description": "Injects the nerdbrain project page at session start; migrates a legacy ## Platform section to the user config; warns when the installed nerdway plugin is older than main or stale copies of its skills sit in user skill directories; reminds about the issue and blocks git commit and git push on a branch without an issue ID in repos with a nerdway platform config",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-install.sh\" claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/migrate-platform.ts\" --runtime claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ts\" --runtime claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/require-issue.ts\" --runtime claude --event reminder",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/require-issue.ts\" --runtime claude --event gate",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/require-issue.ts\" --runtime claude --event gate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
